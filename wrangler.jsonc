{
  // Cloudflare Worker: serves the static site from ./dist and handles /api, /go, /admin.
  // Build dist first:  sh _build/dist.sh      Deploy:  npx wrangler deploy
  "name": "loyaltyprogramguy",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  // Serve the real domain. DNS records for both hostnames must be proxied (orange cloud).
  "routes": [
    { "pattern": "loyaltyprogramguy.com/*", "zone_name": "loyaltyprogramguy.com" },
    { "pattern": "www.loyaltyprogramguy.com/*", "zone_name": "loyaltyprogramguy.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Every request goes through the Worker first (www/http redirects, A/B, API). Static files are
    // then served via env.ASSETS. Well within the free plan's 100,000 requests/day.
    "run_worker_first": true
  },
  "vars": {
    // Public site key (safe to commit). The secret lives in: wrangler secret put TURNSTILE_SECRET
    "TURNSTILE_SITEKEY": "0x4AAAAAAE464HQGRgClczAY"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lpg-data", "database_id": "452315da-bbd5-4af2-8de8-caa92ef774f3", "migrations_dir": "migrations" }
  ]
}
